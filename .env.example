# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# --- MyAnimeList API ---
# Register an app at https://myanimelist.net/apiconfig (app type: "other",
# redirect URI: http://localhost:<BACKEND_PORT>/callback, matching the port below).
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# --- Ports exposed on localhost ---
# BACKEND_PORT also determines the OAuth redirect URI (http://localhost:<BACKEND_PORT>/callback)
# — it must match the redirect URI registered with your MAL app above.
BACKEND_PORT=5050
FRONTEND_PORT=5173

# --- Postgres ---
POSTGRES_DB=animetracker
POSTGRES_USER=animetracker
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5434
